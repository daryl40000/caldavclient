# English translations for the CalDAV Client module

# Module name and description
ModuleCalDAvClientName=CalDAV Client
ModuleCalDAvClientDesc=Allows Dolibarr to act as a CalDAV client and integrate external calendars (e.g. Nextcloud) with the Dolibarr agenda for reading and writing.
# Module license (GNU GPL v3 or later — SPDX GPL-3.0-or-later)
ModuleCalDAvClientLicense=GNU General Public License v3 or later (GPL-3.0-or-later)

